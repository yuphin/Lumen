integrator: 
  type: vcm
  path_length: 6
  sky_col: v3f(0.000000, 0.000000, 0.000000)
  enable_vm: 0
  radius_factor: 0.025000

textures: 

bsdfs: 
  - name: Glass
    type: glass
    albedo: v3f(1.000000, 1.000000, 1.000000)
    ior: 1.520000

  - name: Mirror
    type: mirror
    albedo: v3f(1.000000, 1.000000, 1.000000)

  - name: Left Wall
    type: diffuse
    albedo: v3f(0.630000, 0.065000, 0.050000)

  - name: Right Wall
    type: diffuse
    albedo: v3f(0.140000, 0.450000, 0.091000)

  - name: Other Walls
    type: diffuse
    albedo: v3f(0.725000, 0.710000, 0.680000)

  - name: Light
    type: diffuse
    albedo: v3f(0.000000, 0.000000, 0.000000)
    emissive_factor: v3f(51.000000, 36.000000, 12.000000)


camera: 
  fov: 45.000000
  position: v3f(0.700000, 0.500000, 15.500000)
  rotation: v3f(0.000000, 0.000000, 0.000000)
  dir: v3f(-0.000000, 0.000000, 1.000000)

mesh: 
  - name: occluded.obj
    materials: 
      - refs: back_wall
        name: Other Walls

      - refs: floor
        name: Other Walls

      - refs: ceiling
        name: Other Walls

      - refs: left_wall
        name: Left Wall

      - refs: right_wall
        name: Right Wall

      - refs: light
        name: Light

      - refs: mirror_sphere
        name: Mirror

      - refs: glass_sphere
        name: Glass

      - refs: obstacle
        name: Other Walls

      - refs: cube2
        name: Other Walls

      - refs: cube1
        name: Other Walls



