integrator: 
  type: path
  path_length: 10
  sky_col: v3f(0.500000, 0.500000, 0.500000)

textures: 

bsdfs: 
  - name: Dielectric1
    type: dielectric
    albedo: v3f(1.000000, 1.000000, 1.000000)
    ior: 1.520000
    roughness: 0.000000
    transmission: 1
    reflection: 1

  - name: Dielectric2
    type: dielectric
    albedo: v3f(1.000000, 1.000000, 1.000000)
    ior: 1.520000
    roughness: 0.000000
    transmission: 1
    reflection: 1

  - name: Dielectric3
    type: dielectric
    albedo: v3f(1.000000, 1.000000, 1.000000)
    ior: 1.520000
    roughness: 0.100000
    transmission: 1
    reflection: 1

  - name: Mirror
    type: mirror
    albedo: v3f(1.000000, 1.000000, 1.000000)

  - name: Conductor
    type: conductor
    albedo: v3f(1.000000, 1.000000, 1.000000)
    roughness: 0.200000
    reflectivity: v3f(0.999001, 0.999001, 0.000000)
    edge_tint: v3f(0.999750, 0.999750, 0.000000)

  - name: Principled1
    type: principled
    albedo: v3f(0.000000, 0.000000, 1.000000)
    ior: 1.000000
    roughness: 0.100000
    diffuse_transmission: 0.000000
    specular_transmission: 0.000000
    metallic: 0.500000
    specular_tint: 0.500000
    sheen_tint: 0.500000
    clearcoat: 0.000000
    clearcoat_gloss: 1.000000
    subsurface: 0.000000
    flatness: 0.000000
    sheen: 0.000000
    anisotropy: 0.000000
    thin: 0

  - name: Principled2
    type: principled
    albedo: v3f(1.000000, 0.000000, 1.000000)
    ior: 1.000000
    roughness: 1.000000
    diffuse_transmission: 0.000000
    specular_transmission: 0.000000
    metallic: 0.000000
    specular_tint: 0.000000
    sheen_tint: 0.500000
    clearcoat: 0.000000
    clearcoat_gloss: 1.000000
    subsurface: 0.000000
    flatness: 0.000000
    sheen: 0.000000
    anisotropy: 0.000000
    thin: 0

  - name: Principled3
