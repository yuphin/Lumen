    albedo: v3f(1.000000, 0.000000, 1.000000)
    ior: 1.000000
    roughness: 0.200000
    diffuse_transmission: 0.000000
    specular_transmission: 0.000000
    metallic: 0.000000
    specular_tint: 0.000000
    sheen_tint: 0.500000
    clearcoat: 0.000000
    clearcoat_gloss: 0.000000
    subsurface: 0.000000
    flatness: 0.000000
    sheen: 0.000000
    anisotropy: 0.000000
    thin: 0

  - name: Principled4
    type: principled
    albedo: v3f(1.000000, 1.000000, 1.000000)
    ior: 1.000000
    roughness: 0.200000
    diffuse_transmission: 0.000000
    specular_transmission: 0.800000
    metallic: 1.000000
    specular_tint: 0.000000
    sheen_tint: 0.500000
    clearcoat: 0.000000
    clearcoat_gloss: 0.000000
    subsurface: 0.000000
    flatness: 0.000000
    sheen: 0.000000
    anisotropy: 1.000000
    thin: 0

  - name: Principled5
    type: principled
    albedo: v3f(1.000000, 1.000000, 1.000000)
    ior: 1.000000
    roughness: 0.200000
    diffuse_transmission: 0.000000
    specular_transmission: 0.000000
    metallic: 1.000000
    specular_tint: 0.000000
    sheen_tint: 0.500000
    clearcoat: 0.000000
    clearcoat_gloss: 0.000000
    subsurface: 0.000000
    flatness: 0.000000
    sheen: 0.000000
    anisotropy: 0.000000
    thin: 0

  - name: Principled6
    type: principled
    albedo: v3f(1.000000, 0.000000, 1.000000)
    ior: 1.520000
    roughness: 0.200000
    diffuse_transmission: 0.000000
    specular_transmission: 0.800000
    metallic: 0.000000
    specular_tint: 0.000000
    sheen_tint: 0.500000
    clearcoat: 0.000000
    clearcoat_gloss: 0.000000
    subsurface: 0.000000
    flatness: 0.000000
