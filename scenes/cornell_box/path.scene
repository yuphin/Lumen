integrator:
  type: path
  path_length: 10
  sky_col: v3f(0.2 ,0.3, 1  )


textures:
  - name: Wood
    file: wood1.jpg

bsdfs:
  - ior: 1.52
    name: Glass
    albedo: v3f(1,1,1)
    type: dielectric

  - name: Mirror
    type: mirror

  - albedo: v3f(0.63, 0.065, 0.05)
    name: Left Wall
    type: diffuse

  - albedo: v3f(0.14, 0.45, 0.091)
    name: Right Wall
    type: diffuse

  - albedo: v3f(0.725, 0.71, 0.68)
    name: Other Walls
    type: diffuse

  - albedo: v3f(0.725, 0.71, 0.68)
    name: Floor
    texture: Wood
    type: diffuse

  - emissive_factor: v3f(17, 12, 4)
    albedo: v3f(1,1,1)
    name: Light
    type: diffuse

  - name: Conductor
    type: conductor
    roughness: 0.2
    reflectivity: v3f(0.95652, 0.79155, 0.40800)
    edge_tint: v3f(0.95706, 0.86370, 0.61991)
  
  - name: Conductor2
    type: conductor
    roughness: 0.2
    reflectivity: v3f(0.999001, 0.000000, 0.000000)
    edge_tint: v3f(0.999750, 0.000000, 0.000000)

camera:
  fov: 45
  position: v3f(3.40, -3.39, 7.35)
  rotation: v3f(-3.80, 24.55, 0.00)
  dir: v3f(-0.41, -0.07, 0.91)


mesh:
  - name: cornell_box.obj
    materials:
      - refs: [ceiling, back_wall]
        name: Other Walls
      - refs: [glass_sphere]
        name: Conductor2
      - refs: [mirror_sphere]
        name: Mirror
      - refs: [left_wall]
        name: Left Wall
      - refs: [right_wall]
        name: Right Wall
      - refs: [floor]
        name: Floor
      - refs: [light]
        name: Light
