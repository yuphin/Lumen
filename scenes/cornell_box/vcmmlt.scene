integrator: 
  type: vcmmlt
  path_length: 6
  sky_col: v3f(1.000000, 1.000000, 1.000000)
  mutations_per_pixel: 100.000000
  num_mlt_threads: 45000
  num_bootstrap_samples: 45000
  radius_factor: 0.025000
  enable_vm: 1
  alternate: 1
  light_first: 0

textures: 

bsdfs: 
  - name: Glass
    type: glass
    albedo: v3f(1.000000, 1.000000, 1.000000)
    ior: 1.520000

  - name: Mirror
    type: mirror
    albedo: v3f(1.000000, 1.000000, 1.000000)

  - name: Left Wall
    type: diffuse
    albedo: v3f(0.630000, 0.065000, 0.050000)

  - name: Right Wall
    type: diffuse
    albedo: v3f(0.140000, 0.450000, 0.091000)

  - name: Other Walls
    type: diffuse
    albedo: v3f(0.725000, 0.710000, 0.680000)

  - name: Floor
    type: diffuse
    albedo: v3f(0.725000, 0.710000, 0.680000)

  - name: Light
    type: diffuse
    albedo: v3f(1.000000, 1.000000, 1.000000)
    emissive_factor: v3f(17.000000, 12.000000, 4.000000)


camera: 
  fov: 45.000000
  position: v3f(0.700000, 0.500000, 17.500000)
  rotation: v3f(0.000000, 0.000000, 0.000000)
  dir: v3f(-0.000000, 0.000000, 1.000000)

mesh: 
  - name: cornell_box.obj
    materials: 
      - refs: back_wall
        name: Other Walls

      - refs: floor
        name: Floor

      - refs: ceiling
        name: Other Walls

      - refs: left_wall
        name: Left Wall

      - refs: right_wall
        name: Right Wall

      - refs: light
        name: Light

      - refs: mirror_sphere
        name: Mirror

      - refs: glass_sphere
        name: Glass



