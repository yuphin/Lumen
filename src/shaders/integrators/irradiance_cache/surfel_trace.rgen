#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_scalar_block_layout : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_debug_printf : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_atomic_float : require

#include "../../bda.glsl"
#include "../../commons.glsl"
#include "ir_commons.h"
#include "ir_commons.glsl"
const uint flags = gl_RayFlagsOpaqueEXT;
const float tmin = 0.001;
const float tmax = 10000.0;
layout(location = 0) rayPayloadEXT SurfaceHitPayload payload;
layout(location = 1) rayPayloadEXT AnyHitPayload any_hit_payload;
layout(push_constant) uniform _PushConstantRay { PCIRCache pc; };

#include "direct_lighting.glsl"

SCENE_BUFFER(surfel_pool, Surfel);
SCENE_BUFFER(surfel_details, SurfelDetail);

SCENE_BUFFER(surfel_samples, SurfelSample);

uvec4 sampling_seed = init_rng(gl_LaunchIDEXT.xy, gl_LaunchSizeEXT.xy, pc.sampling_seed);

uvec2 sobol_2d(uint i) {
	uint x = bitfieldReverse(i);
	uint y = 0u;
	for (uint v = 1u << 31; i != 0u; i >>= 1, v ^= v >> 1) {
		if ((i & 1u) != 0u) {
			y ^= v;
		}
	}
	return uvec2(x, y);
}

void main() {
	uint tid = gl_LaunchIDEXT.y;
	if (tid >= MAX_SURFEL_COUNT) {
		return;
	}

	Surfel surfel = DEREF(surfel_pool)[tid];

	if (surfel.radius <= 0.0f) {
		return;
	}

	SurfelDetail detail = DEREF(surfel_details)[tid];
	SurfaceData surfel_hit_data = load_surface(detail.gbuffer);
	vec3 n_s = surfel_hit_data.n_s;
	vec3 n_g = surfel_hit_data.n_g;
	if ((detail.flags & SURFEL_FLAG_BACK_FACING) != 0) {
		n_g = -n_g;
	}
	if (dot(n_g, n_s) < 0.0) {
		n_s = -n_s;
	}

#if 1
	uvec2 scramble = pcg4d(uvec4(tid, pc.sampling_seed, 0u, 0u)).xy;
	uvec2 bits = sobol_2d(gl_LaunchIDEXT.x) ^ scramble;
	vec2 xi = vec2(uint_to_float(bits.x), uint_to_float(bits.y));
	vec3 wi = sample_hemisphere(xi, n_s);
#else
	vec3 wi = sample_hemisphere(rand2(sampling_seed), n_s);
#endif

	vec3 radiance = vec3(0);
	float hit_t = 0.0;
	if (dot(wi, n_g) > 0.0) {
		vec3 surfel_origin = offset_ray(surfel_hit_data.pos, n_g, wi);
		traceRayEXT(tlas, flags, 0x1, 0, 0, 0, surfel_origin, tmin, wi, tmax, 0);
		hit_t = payload.dist;

		if (!surface_ref_valid(payload.surface)) {
#ifdef ENABLE_ATMOSPHERE
			radiance = shade_atmosphere(pc.dir_light_idx, pc.sky_col, surfel_origin, wi, tmax);
#else
			radiance = pc.sky_col;
#endif	// ENABLE_ATMOSPHERE
		} else {
			SurfaceData hit_data = load_surface(payload.surface);
			vec3 wo = -wi;
			Material hit_material = load_material(hit_data.material_idx, hit_data.uv);
			bool forward_facing = face_forward(hit_data.n_s, hit_data.n_g, wo);
			radiance = sample_direct_light(sampling_seed, hit_data.pos, hit_data.n_s, hit_data.n_g, wo, hit_material,
										   forward_facing);
		}
	}

	SurfelSample surfel_sample;
	// cosine sample pdf = 1/ pi
	surfel_sample.radiance = radiance * PI;
	surfel_sample.hit_t = hit_t;

	uint linear_idx = gl_LaunchIDEXT.y * pc.rays_per_surfel + gl_LaunchIDEXT.x;
	DEREF(surfel_samples)[linear_idx] = surfel_sample;
}
