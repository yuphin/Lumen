#version 460
#extension GL_EXT_scalar_block_layout : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_debug_printf : enable

#include "../../bda.glsl"
#include "ir_commons.h"
layout(push_constant) uniform _PushConstantRay { PCIRCache pc; };
layout(binding = 0) buffer SceneDesc_ { SceneDesc scene_desc; };
layout(binding = 1) uniform SceneUBOBuffer { SceneUBO ubo; };
#include "../../scene_buffers.glsl"

#include "ir_commons.glsl"
#include "surfel_commons.glsl"


SCENE_BUFFER(surfel_pool, Surfel);
SCENE_BUFFER_SCALAR(surfel_free_stack_count, int);
SCENE_BUFFER(surfel_free_stack, uint);

layout(local_size_x = ALLOCATE_PASS_WG_SIZE, local_size_y = 1, local_size_z = 1) in;

float max_px_per_trapezoidal_cell() {
	float px_vertical = ubo.projection[1][1] * pc.height / GRID_TRAPEZOIDAL_CELL_COUNT_AXIS;
	return abs(px_vertical);
}

float max_surfel_radius_px() {
	return abs(ubo.projection[1][1] * pc.height / (2.0f * sqrt(3.0f) * GRID_TRAPEZOIDAL_CELL_COUNT_AXIS));
}

void recycle_surfel(uint surfel_id) {
	DEREF(surfel_pool)[surfel_id].radius = 0;
	int idx = atomicAdd(DEREF(surfel_free_stack_count), 1);
	DEREF(surfel_free_stack)[idx] = surfel_id;
}

void main() {
	uint tid = gl_GlobalInvocationID.x;
	if (tid >= MAX_SURFEL_COUNT) {
		return;
	}
	Surfel surfel = DEREF(surfel_pool)[tid];

	if (surfel.radius <= 0.0f) {
		return;
	}

	SurfaceData surfel_hit_data = load_surface(surfel.gbuffer);
	vec4 view_pos = ubo.view * vec4(surfel_hit_data.pos, 1.0);

#if 0
	// Surfel is behind the camera
	if (view_pos.z >= 0.0) {
		// TODO: Handle this later
		return;
	}
#endif

	float px_size = surfel_radius_px_size_for_position(surfel, surfel_hit_data.pos, view_pos);
	float max_radius = max_surfel_radius_px();
	if (px_size >= max_radius || px_size < 0.9 * pc.desired_surfel_radius_px) {
		recycle_surfel(tid);
	}
}
