#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_scalar_block_layout : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_debug_printf : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_atomic_float : require

#include "restirgi_commons.h"
#include "../../../commons.glsl"
layout(location = 0) rayPayloadEXT SurfaceHitPayload payload;
layout(location = 1) rayPayloadEXT AnyHitPayload any_hit_payload;
#include "../../../shadow_ray.glsl"
#include "restirgi_commons.glsl"
#define M_MAX 500

SCENE_BUFFER(spatial_reservoir, Reservoir);
SCENE_BUFFER(temporal_reservoir, Reservoir);
SCENE_BUFFER(restir_samples, ReservoirSample);

void combine_reservoir(inout Reservoir r1, const Reservoir r2,
                       const ReservoirSample q, const SurfaceData q_v, const SurfaceData q_s,
                       out bool gt) {

    const uint r2_m = min(r2.m, M_MAX);
    float r2_hat = p_hat(r2.s.L_o);
    gt = false;
    if (!surface_ref_valid(r2.s.x_v_surface) || !surface_ref_valid(r2.s.x_s_surface)) {
        return;
    }
    const SurfaceData r2_v = load_surface(r2.s.x_v_surface);
    const SurfaceData r2_s = load_surface(r2.s.x_s_surface);
    // // Check visibility
    any_hit_payload.hit = 1;
    vec3 wi = r2_s.pos - q_v.pos;
    const float wi_len = length(wi);
    wi /= wi_len;
    bool visible;
    if ((q.bsdf_props & BSDF_FLAG_TRANSMISSION) == 0) {
        const vec3 ray_origin = offset_ray(q_v.pos, q_v.n_g, wi);
        visible = !connection_occluded(ray_origin, wi, wi_len, 0xFF);
    } else {
        visible = q.p_q > 0;
    }

    if (!visible) {
        r2_hat = 0;
    } else {
        // Calculate Jacobian
        vec3 w_qq = q_v.pos - q_s.pos;
        const float w_qq_len = length(w_qq);
        w_qq /= w_qq_len;
        vec3 w_rq = r2_v.pos - q_s.pos;
        const float w_rq_len = length(w_rq);
        w_rq /= w_rq_len;
        const float qq = w_qq_len * w_qq_len;
        const float rq = w_rq_len * w_rq_len;
        const float div = rq * abs(dot(w_qq, q_s.n_s));
        const float j = div == 0 ? 0 : abs(dot(w_rq, q_s.n_s)) * qq / div;
        r2_hat *= j;
    }

    const float factor = r2_hat * r2_m * r2.W;
    gt = factor > 0;
    if (factor > 0) {
        update_reservoir(r1, r2.s, factor);
    }
}

void main() {
    // TODO: Adaptively change this
    const uint pingpong = (pc.total_frame_num % 2);
    const float max_r = 10;
    const float dist_threshold = 0.01;
    const float angle_threshold = 25 * PI / 180;
    ReservoirSample q = DEREF(restir_samples)[pixel_idx];
    if (!surface_ref_valid(q.x_v_surface) || !surface_ref_valid(q.x_s_surface)) {
        Reservoir empty;
        init_reservoir(empty);
        DEREF(spatial_reservoir)[offset(pingpong) + pixel_idx] = empty;
        return;
    }
    const SurfaceData q_v = load_surface(q.x_v_surface);
    const SurfaceData q_s = load_surface(q.x_s_surface);
    Reservoir r_s;
   
    if (pc.do_spatiotemporal == 1) {
        r_s = DEREF(spatial_reservoir)[offset(pingpong ^ 1) + pixel_idx];
    } else {
        init_reservoir(r_s);
    }

    const uint max_iter = r_s.m < M_MAX / 2 ? 9 : 3;
    vec3 Q[9] = vec3[9](vec3(0), vec3(0), vec3(0), vec3(0), vec3(0), vec3(0),
                        vec3(0), vec3(0), vec3(0));
    uint Q_h[9] = uint[9](0, 0, 0, 0, 0, 0, 0, 0, 0);
    uint q_cnt = 0;

    Reservoir r;
    r.w_sum = 0;
    r.W = 0;
    r.m = 0;
    const float factor =
        pc.do_spatiotemporal == 0 ? 0 : r_s.m * r_s.W * p_hat(r_s.s.L_o);
    if (factor > 0) {
        update_reservoir(r, r_s.s, factor);
    }
    uint Z = r_s.m;
    uint sum = r_s.m;
    ReservoirSample q_n;

    for (int i = 0; i < max_iter; i++) {
        // Choose a neighbor pixel
        const float randa = rand(seed) * 2 * PI;
        const float randr = sqrt(rand(seed)) * max_r;
        ivec2 rand_offset =
            ivec2(floor(cos(randa) * randr), floor(sin(randa) * randr));
        const ivec2 coords = clamp(ivec2(gl_LaunchIDEXT.xy) + rand_offset,
                                   ivec2(0), ivec2(gl_LaunchSizeEXT.xy) - 1);
        const uint coords_idx = coords.x * pc.height + coords.y;

        q_n = DEREF(restir_samples)[coords_idx];
        if (!surface_ref_valid(q_n.x_v_surface) || !surface_ref_valid(q_n.x_s_surface)) {
            continue;
        }
        const SurfaceData q_n_v = load_surface(q_n.x_v_surface);
        const SurfaceData q_n_s = load_surface(q_n.x_s_surface);
        // Geometric similarity
        float dist = dot(q_n_v.pos - q_v.pos, q_n_v.pos - q_v.pos);
        if (dist > dist_threshold ||
            (dot(q_n_v.n_s, q_v.n_s)) < cos(angle_threshold)) {
            continue;
        }
        Reservoir r_n = DEREF(temporal_reservoir)[offset(pingpong ^ 1) + coords_idx];
        bool gt;
        combine_reservoir(r, r_n, q, q_v, q_s, gt);
        Q_h[q_cnt] = r_n.m;
        Q[q_cnt++] = q_n_s.pos;
        sum += r_n.m;
    }
    const float phat_val = p_hat(r.s.L_o);
    if (phat_val > 0 && surface_ref_valid(r.s.x_v_surface)) {
        const SurfaceData selected_v = load_surface(r.s.x_v_surface);
        for (int i = 0; i < q_cnt; i++) {

            vec3 dir = Q[i] - selected_v.pos;
            float len = length(dir);
            dir /= len;
            const vec3 o = offset_ray(selected_v.pos, selected_v.n_g, dir);
            const bool mat_transmissive =
                (r.s.bsdf_props & BSDF_FLAG_TRANSMISSION) == BSDF_FLAG_TRANSMISSION;
            bool visible = true;
            if (!mat_transmissive) {
                visible = !connection_occluded(o, dir, len, 0xFF);
            }
            if (visible) {
                Z += Q_h[i];
            }
        }
    }

    r.m = min(sum, M_MAX);
    r.W = Z * phat_val == 0 ? 0 : r.w_sum / (Z * phat_val);
#define sr DEREF(spatial_reservoir)[offset(pingpong) + pixel_idx]
    sr.w_sum = r.w_sum;
    sr.W = r.W;
    sr.m = r.m;
    sr.s = r.s;
}
