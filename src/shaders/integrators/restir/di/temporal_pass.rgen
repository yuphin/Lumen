#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_scalar_block_layout : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_debug_printf : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_atomic_float : require

#include "restirdi_commons.h"
#include "restirdi_commons.glsl"
#include "../../pt_commons.glsl"

void main() {
    const vec2 pixel = vec2(gl_LaunchIDEXT.xy) + vec2(0.5);
    const vec2 in_uv = pixel / vec2(gl_LaunchSizeEXT.xy);
    vec2 d = in_uv * 2.0 - 1.0;
    origin = (ubo.inv_view * vec4(0, 0, 0, 1)).xyz;
    vec4 target = ubo.inv_projection * vec4(d.x, d.y, 1, 1);
    vec3 direction = vec3(sample_camera(d));
    vec3 throughput = vec3(1);
    RestirReservoir r_new;
    RestirReservoir r_prev;
    RestirReservoir r;
    init_reservoir(r_new);
    init_reservoir(r_prev);
    init_reservoir(r);
    traceRayEXT(tlas, flags, 0xFF, 0, 0, 0, origin, tmin, direction, tmax, 0);

    pos = payload.pos;
    uv = payload.uv;
    mat_idx = payload.material_idx;
    const bool found_isect = mat_idx != -1;
    const vec3 wo = normalize(origin - pos);
    if (found_isect) {
        vec3 n_s = payload.n_s;
        bool side = true;
        vec3 n_g = payload.n_g;
        if (dot(payload.n_g, wo) < 0.)
            n_g = -n_g;
        if (dot(n_g, payload.n_s) < 0) {
            n_s = -n_s;
            side = false;
        }
        normal = n_s;
        geometric_normal = n_g;
        float cos_wo = dot(wo, n_s);

        const Material hit_mat = load_material(mat_idx, uv);

        // Generate samples

        const uint light_samples = pc.num_lights > 0 ? pc.light_candidate_count : 0;

        if (pc.do_spatiotemporal == 1 &&
            ((hit_mat.bsdf_props & BSDF_FLAG_SPECULAR) == 0)) {

            vec4 prev_pos = ubo.prev_view * vec4(pos, 1);
            prev_pos /= prev_pos.z;
            prev_pos = -ubo.prev_projection * prev_pos;
            ivec2 prev_coords =
                ivec2(0.5 * (1 + prev_pos.xy) * gl_LaunchSizeEXT.xy);
            if ((prev_coords.x < gl_LaunchSizeEXT.x && prev_coords.x >= 0) &&
                (prev_coords.y < gl_LaunchSizeEXT.y && prev_coords.y >= 0)) {
                r_prev = DEREF(temporal_reservoir)[pixel_idx];
            }
        }

        for (int i = 0; i < light_samples; i++) {
            const LightLiSample light_sample = sample_light_Li(rand4(seed), payload.pos, pc.num_lights);

            float bsdf_pdf;
            const vec3 f =
                eval_bsdf(normal, n_g, wo, hit_mat, TRANSPORT_MODE_FROM_CAMERA, side, light_sample.wi, bsdf_pdf);

            RestirData s;
            s.identity = light_sample.identity;
            const float p_hat = length(f * light_sample.Li * abs(dot(normal, light_sample.wi)));
            update_reservoir(r_new, s,
                             light_sample.pdf_position_w > 0.0
                                 ? p_hat / light_sample.pdf_position_w
                                 : 0.0);
        }

        // Visibility check for the selected candidate
        if (r_new.w_sum > 0) {
            const RestirData s = r_new.s;
            const LightLiSample light_sample = replay_light_Li(s.identity, payload.pos, pc.num_lights);

            const bool unoccluded =
                !connection_occluded(offset_ray2(pos, n_g, dot(light_sample.wi, n_g) < 0.0), light_sample.wi,
                                     light_sample.distance, 0xFF);
            vec3 f = eval_bsdf(normal, n_g, wo, hit_mat, TRANSPORT_MODE_FROM_CAMERA, side, light_sample.wi);
            bool visible = unoccluded && f != vec3(0);
            r_new.W = 0;
            if (visible) {
                const float p_hat = length(f * light_sample.Li * abs(dot(normal, light_sample.wi)));
                if (p_hat == 0) {
                    r_new.W = 0;
                } else {
                    r_new.W = r_new.w_sum / (p_hat * r_new.m);
                }
            }
        }
        // Temporal reuse
        combine_reservoir(r, r_new);
        uint num_samples = r_new.m;
        if (pc.do_spatiotemporal == 1) {
            // Limit history relative to the number of fresh candidates, not
            // the single reservoir item inserted by combine_reservoir().
            r_prev.m = min(20 * r_new.m, r_prev.m);
            combine_reservoir(r, r_prev);
            num_samples += r_prev.m;
        }
        r.m = num_samples;
        if (r_new.W > 0 || r_prev.W > 0) {
            const float phat = calc_p_hat(r) * r.m;
            r.W = phat == 0 ? 0 : r.w_sum / (phat);
        } else {
            r.W = 0;
        }

        // Write to g-buffer
        DEREF(g_buffer)[pixel_idx].pos = pos;
        DEREF(g_buffer)[pixel_idx].normal = normal;
        DEREF(g_buffer)[pixel_idx].n_g = n_g;
        DEREF(g_buffer)[pixel_idx].uv = uv;
        DEREF(g_buffer)[pixel_idx].mat_idx = mat_idx;

        // Sample direction & update throughput
        vec3 col = hit_mat.emissive_factor;
        float pdf, cos_theta;
        vec3 f = sample_bsdf(normal, n_g, wo, hit_mat, TRANSPORT_MODE_FROM_CAMERA, side,
                             direction, pdf, cos_theta, seed);
        origin = offset_ray(pos, n_g, direction);
        throughput *= f * abs(cos_theta) / pdf;
        bool specular = (hit_mat.bsdf_props & BSDF_FLAG_SPECULAR) != 0;
        // Do traditional path tracing
        for (int depth = 1;; depth++) {
            traceRayEXT(tlas, flags, 0xFF, 0, 0, 0, origin, tmin, direction,
                        tmax, 0);
            const bool found_isect = payload.material_idx != -1;
            if (depth >= pc.max_depth - 1) {
                break;
            }
            if (!found_isect) {
                col += throughput * pc.sky_col;
                break;
            }
            const Material hit_mat =
                load_material(payload.material_idx, payload.uv);
            if (specular) {
                col += throughput * hit_mat.emissive_factor;
            }
            const vec3 wo = -direction;
            vec3 n_s = payload.n_s;
            bool side = true;
            vec3 n_g = payload.n_g;
            if (dot(payload.n_g, wo) < 0.)
                n_g = -n_g;
            if (dot(n_g, payload.n_s) < 0) {
                n_s = -n_s;
                side = false;
            }
            float cos_wo = dot(wo, n_s);
            if ((hit_mat.bsdf_props & BSDF_FLAG_SPECULAR) == 0) {
                col += throughput *
                       sample_direct_light(seed, hit_mat, payload.pos, side, n_s, n_g, wo,
                                           /*use_mis=*/false, specular);
            }
            // Sample direction & update throughput
            float pdf, cos_theta;
            const vec3 f = sample_bsdf(n_s, n_g, wo, hit_mat,
                                       TRANSPORT_MODE_FROM_CAMERA,
                                       side, direction, pdf, cos_theta, seed);
            if (pdf == 0) {
                break;
            }
            origin = offset_ray(payload.pos, n_g, direction);
            throughput *= f * abs(cos_theta) / pdf;
            specular = (hit_mat.bsdf_props & BSDF_FLAG_SPECULAR) != 0;
            float rr_scale = 1.0;
            if (hit_mat.bsdf_type == BSDF_TYPE_GLASS) {
                rr_scale *= side ? 1. / hit_mat.ior : hit_mat.ior;
            }
            if (depth > RR_MIN_DEPTH) {
                float rr_prob = min(0.95f, luminance(throughput) * rr_scale);
                if (rr_prob < rand(seed))
                    break;
                else
                    throughput /= rr_prob;
            }
        }
        DEREF(color_storage)[pixel_idx] = col;
    }
    // Save the reservoirs for spatial reuse
    DEREF(passthrough_reservoir)[pixel_idx].w_sum = r.w_sum;
    DEREF(passthrough_reservoir)[pixel_idx].W = r.W;
    DEREF(passthrough_reservoir)[pixel_idx].m = r.m;
    DEREF(passthrough_reservoir)[pixel_idx].s = r.s;
}
